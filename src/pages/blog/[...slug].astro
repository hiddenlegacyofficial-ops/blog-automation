---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = new Date(post.data.pubDate).toLocaleDateString('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout
  title={`${post.data.title} — Syntexic`}
  description={post.data.description}
  type="article"
  pubDate={post.data.pubDate}
  author={post.data.author}
  category={post.data.category}
  activeNav="blog"
>
  <article class="article-wrap">
    <!-- Post Header -->
    <header class="article-header">
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/blog">Blog</a>
        <span class="sep">/</span>
        <span class="current">{post.data.category}</span>
      </nav>

      <div class="article-meta">
        <span class={`pill ${post.data.categoryPillClass}`}>{post.data.category}</span>
        <span class="meta-item">{post.data.readTime}</span>
        <span class="meta-dot">•</span>
        <time class="meta-item" datetime={new Date(post.data.pubDate).toISOString()}>{formattedDate}</time>
      </div>

      <h1 class="article-title">{post.data.title}</h1>

      <p class="article-lead">{post.data.description}</p>

      <div class="article-author">
        <div class={`author-avatar ${post.data.authorAvatarBg}`}>{post.data.authorAvatar}</div>
        <div>
          <div class="author-name">{post.data.author}</div>
          <div class="author-title">Syntexic Technical Contributor</div>
        </div>
      </div>
    </header>

    <!-- Post Body -->
    <div class="article-body">
      <Content />
    </div>

    <!-- Article Footer Nav -->
    <footer class="article-footer-nav">
      <a href="/blog" class="back-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        Back to all articles
      </a>
    </footer>
  </article>
</Layout>

<style>
  .article-wrap {
    max-width: 840px;
    margin: 0 auto;
    padding: 64px 24px 96px;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 24px;
  }
  .breadcrumb a {
    color: var(--text-muted);
    transition: color 150ms ease;
  }
  .breadcrumb a:hover {
    color: var(--accent-primary);
  }
  .breadcrumb .sep {
    color: var(--text-subtle);
  }
  .breadcrumb .current {
    color: var(--text-primary);
    font-weight: 500;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .pill {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }
  .pill-ai { background: rgba(99,102,241,0.15); color: #818cf8; }
  .pill-dev { background: rgba(6,182,212,0.12); color: var(--accent-cyan); }
  .pill-tech { background: rgba(168,85,247,0.15); color: #c084fc; }
  .meta-item {
    font-size: 13px;
    color: var(--text-muted);
  }
  .meta-dot {
    color: var(--text-subtle);
  }

  .article-title {
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 20px;
    color: var(--text-primary);
  }
  .article-lead {
    font-size: 1.25rem;
    color: #334155;
    line-height: 1.6;
    margin-bottom: 32px;
    font-weight: 500;
  }

  .article-author {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 20px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    margin-bottom: 48px;
  }
  .author-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
  }
  .author-avatar.blue { background: rgba(99,102,241,0.2); color: #818cf8; }
  .author-avatar.cyan { background: rgba(6,182,212,0.15); color: var(--accent-cyan); }
  .author-avatar.purple { background: rgba(168,85,247,0.15); color: #c084fc; }
  .author-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
  }
  .author-title {
    font-size: 13px;
    color: var(--text-muted);
  }

  /* Markdown Content Styling */
  .article-body {
    font-size: 1.125rem;
    line-height: 1.85;
    color: #1e293b;
    font-weight: 400;
  }
  .article-body :global(h2) {
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 48px 0 20px;
    color: #0f172a;
  }
  .article-body :global(h3) {
    font-size: 1.4rem;
    font-weight: 600;
    margin: 36px 0 16px;
    color: #0f172a;
  }
  .article-body :global(p) {
    margin-bottom: 24px;
    color: #1e293b;
  }
  .article-body :global(strong) {
    color: #0f172a;
    font-weight: 700;
  }
  .article-body :global(a) {
    color: var(--accent-primary);
    font-weight: 600;
    text-decoration: underline;
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 24px 24px;
    color: #1e293b;
  }
  .article-body :global(li) {
    margin-bottom: 10px;
    color: #1e293b;
  }
  .article-body :global(blockquote) {
    border-left: 4px solid var(--accent-primary);
    background: #f8fafc;
    padding: 16px 24px;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: 32px 0;
    font-style: italic;
    color: #1e293b;
    font-weight: 500;
  }
  .article-body :global(pre) {
    background: #0f172a !important;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 20px;
    overflow-x: auto;
    margin: 32px 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    color: #f8fafc;
  }
  .article-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 32px 0;
  }
  .article-body :global(th),
  .article-body :global(td) {
    border: 1px solid #cbd5e1;
    padding: 12px 16px;
    text-align: left;
    color: #1e293b;
  }
  .article-body :global(th) {
    background: #f1f5f9;
    color: #0f172a;
    font-weight: 700;
  }

  .article-footer-nav {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-primary);
    font-weight: 600;
    transition: transform 150ms ease;
  }
  .back-link:hover {
    transform: translateX(-4px);
  }
  .back-link svg {
    width: 18px;
    height: 18px;
  }
</style>
